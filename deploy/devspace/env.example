# Copy to devspace.env (ignored by Git), or run python3 configure.py.
# Generated secrets are required. Never use blank values outside config validation.
DEVSPACE_BIND=127.0.0.1
DEVSPACE_PORT=8089
WEB_URL=http://localhost:8089
CORS_ALLOWED_ORIGINS=http://localhost:8089
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
POSTGRES_USER=devspace
POSTGRES_DB=devspace
POSTGRES_PASSWORD=
RABBITMQ_USER=devspace
RABBITMQ_VHOST=devspace
RABBITMQ_PASSWORD=
AWS_ACCESS_KEY_ID=devspace-storage
AWS_SECRET_ACCESS_KEY=
API_KEY_RATE_LIMIT=60/minute
FILE_SIZE_LIMIT=5242880
