# Copy to mcp.env, chmod 600, fill privately. Empty values intentionally fail startup.
# Public browser origin; also used in source links.
DEVSPACE_URL=http://localhost:8089
DEVSPACE_WORKSPACE_SLUG=your-workspace-slug
# Work reader API token and comma-separated allowed project UUIDs.
DEVSPACE_WORK_API_KEY=
DEVSPACE_PROJECT_IDS=
# Separate explicitly authorized Wiki/Timesheet/Milestone reader token and its user UUID.
DEVSPACE_DOCS_API_KEY=
DEVSPACE_DOCS_USER_ID=
# Optional for host processes. Compose sets this to http://api:8000.
DEVSPACE_API_URL=
